# CZSC Stock Analyzer Configuration
# Copy this file to .env and modify as needed

# Debug Mode
DEBUG=False

# Monitoring Configuration
MONITOR_INTERVAL=300

# TDX Configuration
TDX_TIMEOUT=3

# MACD Parameters
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9

# Data Configuration
DAILY_BARS=300
MIN30_BARS=300

# Logging
LOG_LEVEL=INFO
