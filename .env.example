# CZSC Stock Analyzer Configuration
# Copy this file to .env and modify as needed

# Debug Mode
DEBUG=False

# Monitoring Configuration
MONITOR_INTERVAL=300

# TDX Configuration
TDX_TIMEOUT=3

# MACD Parameters
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9

# Data Configuration
DAILY_BARS=300
MIN30_BARS=300

# MySQL Database Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=stock_kline
USE_MYSQL_DATA=True

# Logging
LOG_LEVEL=INFO
